{
  "version": 4,
  "mode": "artwork",
  "output": {
    "directory": "results",
    "count": 10,
    "resize": { "resize": true, "width": 750, "height": 600 },
    "image_types": { "png": true, "webp": true, "jpeg": false },
    "contact_sheet": true,
    "contact_sheet_page_size": 10
  },
  "work_size": { "resize": true, "width": 1500, "height": 1200 },
  "geometry": {
    "template": "rhombus",
    "offset_x": 0.016,
    "offset_y": 0.020,
    "canvas_margin": 0.005,
    "shapes": {
      "rhombus": { "unit": "px", "width": 135, "height": 197 },
      "square": { "unit": "px", "side": 110 },
      "rectangle": { "unit": "px", "width": 115, "height": 95 },
      "triangle": { "unit": "px", "width": 170, "height": 147 },
      "hexagon": { "unit": "px", "width": 115, "height": 130 },
      "free": {
        "step_x": 1.0,
        "step_y": 1.0,
        "row_shift": 0.0,
        "polygons": [
          [ [ 0, 0 ], [ 0.4, 0 ], [ 0.53, 0.5 ], [ 0.4, 1 ], [ 0, 1 ] ],
          [ [ 0.4, 0 ], [ 1, 0 ], [ 1, 1 ], [ 0.4, 1 ], [ 0.53, 0.5 ] ]
        ]
      }
    }
  },
  "silhouette": {
    "shape": "crystal_superellipse",
    "radius": { "x": 0.6, "y": 0.55},
    "power": { "x": 5.0, "y": 5.0},
    "outer_prune": { "min": 7, "max": 13},
    "allow_detached_facets": false
  },
  "protected_areas": {
    "safety_margin": 0.024,
    "ellipses": [ [ 0.5, 0.49, 0.24, 0.25 ] ]
  },
  "facets": {
    "holes": 8,
    "dark": 24,
    "light": 16,
    "dark_strength": 0.5,
    "light_strength": 0.25,
    "subtle_variation": 0.05,
    "minimum_hole_separation_cells": 0,
    "geometry": {
      "lines": { "opacity": 0.12, "width": 1.05, "color": [235, 240, 255] }
    }
  },
  "finish": {
    "grain": 1.15,
    "contrast": 1.0,
    "saturation": 1.0
  },
  "debug_white": {
    "draw_grid": true,
    "dark_color": [ 171, 185, 210 ],
    "light_color": [ 217, 230, 249 ],
    "normal_color": [ 255, 255, 255 ]
  },
  "batch": {
    "input_directory": ".",
    "continue_on_error": true,
     "retry_on_error": 3
  }
}
